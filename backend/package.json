{
  "name": "tarozi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:advisors": "supabase db advisors --local"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.2",
    "@supabase/supabase-js": "2.118.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "24.19.2",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
