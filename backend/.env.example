# Copy local Supabase output from `npm run db:status`. Never commit .env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:4173/
# Demo offers remain labeled in every response. Set false for a live-data pilot.
INCLUDE_DEMO_DATA=true
